        {
            "statement": {
                "_text": "\u58a9\u58a9\u5411\u8d70\u5eca\u8dd1\u53bb\uff0c\u6700\u7ec8\u5728\u660e\u6697\u4ea4\u754c\u7684\u5730\u65b9\u505c\u4e86\u4e0b\u6765\uff0c\u5c3e\u5df4\u7d27\u7d27\u5939\u5728\u4e24\u817f\u4e4b\u95f4\uff0c\u8eab\u4f53\u5fae\u5fae\u53d1\u6296\uff0c\u56de\u5934\u770b\u5411\u73a9\u5bb6\uff0c\u773c\u795e\u900f\u9732\u51fa\u60ca\u6050\u548c\u6c42\u52a9\u7684\u4fe1\u53f7\uff0c\r\n\u4f60\u4f1a\u9009\u62e9......"

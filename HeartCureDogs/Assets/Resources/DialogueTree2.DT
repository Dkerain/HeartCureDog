        {
            "statement": {
                "_text": "\u7b2c\u4e8c\u6b21\u6295\u7403\u533a\u57df\u5728\u6f06\u9ed1\u7684\u8d70\u5eca\u4e0a\r\n\u591c\u5e55\u964d\u4e34\uff0c\u6240\u6709\u623f\u95f4\u548c\u8d70\u5eca\u88ab\u591c\u8272\u5305\u88f9\uff0c\u552f\u6709\u5ba2\u5385\u7684\u706f\u5149\u72ec\u81ea\u95ea\u8000\u3002"

        {
            "statement": {
                "_text": "\u6b64\u65b9\u6cd5\u867d\u7136\u7b80\u5355\uff0c\u4f46\u662f\u51c6\u786e\u6027\u7565\u4f4e\u4e8e\u76f4\u80a0\u6d4b\u6e29\u6cd5\uff0c\u5f20\u533b\u751f\u4f9d\u65e7\u4f1a\u9009\u62e9\u76f4\u80a0\u6d4b\u6e29\u6cd5\u3002\u76f4\u80a0\u6d4b\u91cf\u6cd5\u80fd\u591f\u76f4\u63a5\u6d4b\u91cf\u72d7\u72d7\u4f53\u5185\u7684\u6838\u5fc3\u6e29\u5ea6\uff0c\u76f8\u8f83\u4e8e\u4f53\u8868\u6e29\u5ea6\u6216\u5176\u4ed6\u90e8\u4f4d\u7684\u6d4b\u91cf\uff0c\u66f4\u80fd\u51c6\u786e\u53cd\u6620\u72d7\u72d7\u7684\u771f\u5b9e\u4f53\u6e29\u3002\u56e0\u4e3a\u76f4\u80a0\u4f4d\u4e8e\u72d7\u72d7\u8eab\u4f53\u7684\u4e2d\u5fc3\u4f4d\u7f6e\uff0c\u53d7\u5916\u754c\u73af\u5883\u5f71\u54cd\u8f83\u5c0f\uff0c\u6240\u4ee5\u6d4b\u91cf\u5f97\u5230\u7684\u4f53\u6e29\u6570\u503c\u66f4\u4e3a\u53ef\u9760\u3002"

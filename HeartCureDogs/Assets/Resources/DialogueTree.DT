        {
            "statement": {
                "_text": "\u738b\u4e50\u4e50\u5c06\u58a9\u58a9\u7684\u524d\u722a\u62ac\u8d77\uff0c\u5f20\u533b\u751f\u8f7b\u8f7b\u5730\u5c06\u4f53\u6e29\u8ba1\u63d2\u5165\u67ef\u57fa\u7684\u76f4\u80a0\u5185\u7ea62-3\u5398\u7c73\uff0c\u786e\u4fdd\u4f53\u6e29\u8ba1\u4e0e\u76f4\u80a0\u58c1\u7d27\u5bc6\u63a5\u89e6\uff0c\u7b49\u5f85\u51e0\u79d2\u949f\u540e\uff0c\u5f20\u533b\u751f\u53d6\u51fa\uff0c\u770b\u4e86\u4e0b\u793a\u6570\uff1a\u5e7c\u72ac\u6b63\u5e38\u4f53\u6e29\u4e3a37.5~39.5\u2103\uff0c\u58a9\u58a938\u2103\uff0c\u5c5e\u4e8e\u6b63\u5e38\u4f53\u6e29\u3002"

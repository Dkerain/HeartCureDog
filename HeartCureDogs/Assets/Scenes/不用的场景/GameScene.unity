  dialogueText: {fileID: 2062678719}
  dialogues:
  - "\u4F60\uFF1A\u5440\uFF0C\u4E00\u5230\u996D\u70B9\u5C31\u8FD9\u4E48\u5174\u594B\u5462\uFF01 "
  - "\u4F60\u8FD8\u60F3\u7EE7\u7EED\u5012\u65F6\u53D1\u73B0\u72D7\u7CAE\u888B\u5DF2\u7ECF\u7A7A\u4E86\uFF0C\u6B64\u65F6\u4F60\u770B\u4E86\u773C\u8868\uFF0C\u4E0A\u73ED\u5FEB\u8981\u8FDF\u5230\u4E86\uFF0C\u4F60\u9762\u4E34\u4E24\u4E2A\u9009\u62E9...... "
  - "\u4F60\u62FF\u7740\u65B0\u7684\u4E00\u888B\u72D7\u7CAE\u51FA\u73B0\uFF0C\u72D7\u72D7\u770B\u7740\u996D\u76C6\u91CC\u591A\u51FA\u7684\u72D7\u7CAE\uFF0C\u53D1\u51FA\u201C\u545C\u545C\u201D\u58F0\uFF0C\u5C3E\u5DF4\u6447\u6765\u6447\u53BB\u7684\uFF0C\u5FC3\u91CC\u5F00\u5FC3\u574F\u4E86\u3002"
  - "\u4F60\uFF1A\u771F\u7FA1\u6155\u4F60\u6709\u8FD9\u4E48\u597D\u7684\u4E3B\u4EBA\uFF0C\u6211\u8D70\u5566\uFF0C\u5728\u5BB6\u4E56\u4E56\u7684\u54E6\u3002"
  - "\u4F60\u79BB\u5F00\u4E86"

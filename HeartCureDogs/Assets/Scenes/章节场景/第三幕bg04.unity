  _serializedExposedParameters: []
  _boundGraphSerialization: '{"type":"NodeCanvas.DialogueTrees.DialogueTree","nodes":[{"statement":{"_text":"\u6f06\u9ed1\u7684\u5ba2\u5385\uff0c\u58a9\u58a9\u8fd8\u8737\u7f29\u5728\u6bef\u5b50\u4e0a\u5b89\u8be6\u5730\u7761\u89c9\u3002"},"_actorName":"\u7cfb\u7edf","_actorParameterID":"37d08775-b2e5-4cab-864f-14bbed2bd41c","_position":{"x":436.6667,"y":35.33334},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"0"},{"statement":{"_text":"\u706f\u4eae\u4e86\uff0c\u58a9\u58a9\u542c\u5230\u58f0\u97f3\uff0c\u5fae\u5fae\u52a8\u4e86\u4e00\u4e0b\uff0c\u6162\u6162\u7741\u5f00\u53cc\u773c\u3002\r\n\u58a9\u58a9\u5f39\u4e86\u8d77\u6765\uff0c\u5c3e\u5df4\u5f00\u59cb\u75af\u72c2\u5730\u6447\u6446\uff0c\u4eff\u4f5b\u8981\u6447\u6389\u6240\u6709\u7684\u77dc\u6301\u548c\u7b49\u5f85\u7684\u7126\u8651\u3002\u5b83\u7684\u524d\u722a\u6025\u5207\u5730\u6252\u62c9\u7740\u5730\u9762\uff0c\u5c0f\u5c0f\u7684\u8eab\u8eaf\u51e0\u4e4e\u8981\u8dc3\u51fa\u5c0f\u7a9d\uff0c\u773c\u795e\u4e2d\u5145\u6ee1\u4e86\u65e0\u6bd4\u7684\u559c\u60a6\u548c\u671f\u5f85\u3002"},"_actorName":"\u7cfb\u7edf","_actorParameterID":"37d08775-b2e5-4cab-864f-14bbed2bd41c","_position":{"x":422.0,"y":113.3333},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"1"},{"statement":{"_text":"\u201c\u6c6a\u6c6a\uff01\u201d\u5b83\u5174\u594b\u5730\u5420\u53eb\u4e86\u4e24\u58f0\uff0c\u58f0\u97f3\u91cc\u8fd8\u5e26\u7740\u4e00\u4e1d\u7a1a\u5ae9\u7684\u5976\u6c14\uff0c\u4f46\u8fd9\u4e1d\u6beb\u6ca1\u6709\u51cf\u5f31\u5b83\u7684\u70ed\u60c5\u3002"},"_actorName":"\u7cfb\u7edf","_actorParameterID":"37d08775-b2e5-4cab-864f-14bbed2bd41c","_position":{"x":409.3334,"y":204.0},"$type":"NodeCanvas.DialogueTrees.StatementNode","$id":"2"},{"statement":{"_text":"\u4f60\u62ff\u7740\u4e00\u4e2a\u8272\u5f69\u6591\u6593\u7684\u5c0f\u7403\uff0c\u58a9\u58a9\u534a\u8e72\u7740\uff0c\u7acb\u523b\u77aa\u5927\u4e86\u773c\u775b\uff0c\u5c3e\u5df4\u5174\u594b\u5730\u6447\u6446\u8d77\u6765\uff0c\u4eff\u4f5b\u5728\u8bf4\uff1a\u201c\u592a\u597d\u4e86